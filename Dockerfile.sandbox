FROM python:3.10-slim

# Prevent Python from writing .pyc files and buffer stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install isolated execution dependencies
RUN pip install --no-cache-dir pytest pydantic

# Ensure /app has open POSIX permissions for mounted volumes
RUN chmod -R 777 /app

# Default command disables pytest cache creation (.pytest_cache) 
# to prevent root/non-root UID host cleanup ownership collisions
CMD ["python", "-m", "pytest", "test_solution.py", "-p", "no:cacheprovider", "-o", "addopts="]